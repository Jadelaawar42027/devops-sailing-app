diff -ruN 04-scoring/ui/styles.css 05-ui/ui/styles.css
--- 04-scoring/ui/styles.css	1970-01-01 01:00:00
+++ 05-ui/ui/styles.css	2026-11-22 20:24:36
@@ -0,0 +1,454 @@
+/* Plain, flat styling on purpose. TODO(team): adjust colours, spacing and copy to taste. */
+:root {
+  --ground: #f4f6f6;
+  --surface: #e6ebec;
+  --ink: #0f1f29;
+  --ink-soft: #46555e;
+  --accent: #0b5d70;
+  --accent-ink: #ffffff;
+  --go: #1e6b3c;
+  --go-soft: #d6eadb;
+  --nogo: #a2281e;
+  --nogo-soft: #f3dad6;
+  --empty: #d3dadc;
+  --focus: #e0a100;
+  --font: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  --gutter: clamp(16px, 4vw, 32px);
+  color-scheme: light;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+body {
+  margin: 0;
+  background: var(--ground);
+  color: var(--ink);
+  font: 400 1rem/1.5 var(--font);
+  -webkit-font-smoothing: antialiased;
+}
+
+a {
+  color: var(--accent);
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+.skip {
+  position: absolute;
+  left: -999px;
+}
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+.skip:focus {
+  left: var(--gutter);
+  top: 8px;
+  background: var(--ink);
+  color: var(--ground);
+  padding: 8px 12px;
+}
+
+/* Header: wordmark, three links */
+.site-header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: 8px 32px;
+  padding: 20px var(--gutter);
+  background: var(--ink);
+  color: var(--ground);
+}
+.wordmark {
+  font-weight: 700;
+  font-size: 1.25rem;
+  letter-spacing: -0.01em;
+  color: inherit;
+  text-decoration: none;
+}
+.site-header nav {
+  display: flex;
+  gap: 24px;
+}
+.site-header nav a {
+  color: var(--ground);
+  text-decoration: none;
+  padding: 4px 0;
+  border-bottom: 3px solid transparent;
+}
+.site-header nav a:hover {
+  border-bottom-color: var(--empty);
+}
+.site-header nav a[aria-current="page"] {
+  border-bottom-color: var(--ground);
+}
+
+main {
+  padding: 40px var(--gutter) 96px;
+  max-width: 1200px;
+}
+
+h1 {
+  font-size: clamp(2rem, 5vw, 3rem);
+  line-height: 1.05;
+  letter-spacing: -0.03em;
+  margin: 0 0 8px;
+  text-wrap: balance;
+}
+h2 {
+  text-wrap: balance;
+  font-size: 1.375rem;
+  line-height: 1.2;
+  letter-spacing: -0.01em;
+  margin: 0 0 12px;
+}
+.lead {
+  font-size: 1.125rem;
+  max-width: 60ch;
+  margin: 0 0 32px;
+}
+.muted {
+  color: var(--ink-soft);
+}
+
+section + section {
+  margin-top: 56px;
+}
+aside {
+  display: grid;
+  gap: 16px;
+}
+aside section + section {
+  margin-top: 0;
+}
+
+/* Two-column layout used on every page; stacks on narrow screens */
+.split {
+  display: grid;
+  grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
+  gap: 40px;
+  align-items: start;
+}
+@media (max-width: 860px) {
+  .split {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+.panel {
+  background: var(--surface);
+  padding: 24px;
+}
+
+/* Forms */
+form {
+  display: grid;
+  gap: 16px;
+}
+.field {
+  display: grid;
+  gap: 4px;
+}
+.field-row {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 12px;
+}
+label {
+  font-weight: 600;
+  font-size: 0.9375rem;
+}
+.hint {
+  font-size: 0.875rem;
+  color: var(--ink-soft);
+}
+input,
+select {
+  font: inherit;
+  color: var(--ink);
+  background: #fff;
+  border: 1px solid #8a979e;
+  padding: 10px 12px;
+  min-height: 44px;
+  width: 100%;
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+}
+button {
+  font: inherit;
+  font-weight: 600;
+  min-height: 44px;
+  padding: 10px 18px;
+  border: 0;
+  cursor: pointer;
+  background: var(--accent);
+  color: var(--accent-ink);
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+}
+button:hover {
+  background: #084a5a;
+}
+button:active {
+  transform: translateY(1px);
+}
+button.secondary {
+  background: var(--empty);
+  color: var(--ink);
+}
+button.secondary:hover {
+  background: #c2cbce;
+}
+button.danger {
+  background: transparent;
+  color: var(--nogo);
+  padding: 10px 8px;
+}
+button.danger:hover {
+  background: var(--nogo-soft);
+}
+button:disabled {
+  opacity: 0.6;
+  cursor: progress;
+}
+
+/* Status messages */
+.message {
+  padding: 12px 16px;
+  margin: 0 0 24px;
+  background: var(--surface);
+}
+form .message {
+  margin: 0;
+}
+.message[data-kind="error"] {
+  background: var(--nogo-soft);
+  color: #6d1912;
+}
+.message[data-kind="ok"] {
+  background: var(--go-soft);
+  color: #12452a;
+}
+
+/* Tables (real tables keep their lines) */
+.table-wrap {
+  overflow-x: auto;
+}
+table {
+  width: 100%;
+  border-collapse: collapse;
+  font-variant-numeric: tabular-nums;
+}
+th,
+td {
+  text-align: left;
+  padding: 10px 12px 10px 0;
+  border-bottom: 1px solid #c8d0d3;
+  vertical-align: top;
+  overflow-wrap: anywhere;
+}
+th {
+  font-size: 0.875rem;
+  color: var(--ink-soft);
+  font-weight: 600;
+}
+td.num,
+th.num {
+  text-align: right;
+  white-space: nowrap;
+}
+.failures {
+  margin: 12px 0 0;
+  padding-left: 20px;
+}
+.failures li + li {
+  margin-top: 6px;
+}
+.row-actions {
+  display: flex;
+  gap: 4px;
+  justify-content: flex-end;
+}
+.empty-state {
+  padding: 24px 0;
+  color: var(--ink-soft);
+}
+
+/* Planner */
+.picker {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+  align-items: end;
+  margin-bottom: 24px;
+}
+.picker .field {
+  min-width: min(100%, 320px);
+}
+.summary {
+  font-size: 1.125rem;
+  margin: 0 0 20px;
+}
+.summary strong {
+  font-size: 2rem;
+  letter-spacing: -0.02em;
+}
+
+/* Timeline: one row per day, 24 hourly cells */
+.timeline {
+  display: grid;
+  gap: 6px;
+}
+.day {
+  display: grid;
+  grid-template-columns: 88px minmax(0, 1fr);
+  gap: 8px;
+  align-items: center;
+}
+.day-label {
+  font-size: 0.875rem;
+  font-weight: 600;
+}
+.hours {
+  display: grid;
+  grid-template-columns: repeat(24, minmax(0, 1fr));
+  gap: 2px;
+}
+.hour {
+  min-height: 36px;
+  padding: 0;
+  background: var(--empty);
+}
+.hour.go {
+  background: var(--go);
+}
+.hour.nogo {
+  background: var(--nogo);
+}
+.hour:hover {
+  opacity: 0.8;
+}
+.hour[aria-pressed="true"] {
+  outline: 3px solid var(--ink);
+  outline-offset: 1px;
+}
+.hour-scale {
+  display: grid;
+  grid-template-columns: 88px minmax(0, 1fr);
+  gap: 8px;
+  font-size: 0.8125rem;
+  color: var(--ink-soft);
+}
+.hour-scale div {
+  display: flex;
+  justify-content: space-between;
+}
+.legend {
+  display: flex;
+  gap: 20px;
+  font-size: 0.875rem;
+  margin-top: 12px;
+}
+.swatch {
+  display: inline-block;
+  width: 14px;
+  height: 14px;
+  vertical-align: -2px;
+  margin-right: 6px;
+}
+.swatch.go {
+  background: var(--go);
+}
+.swatch.nogo {
+  background: var(--nogo);
+}
+.swatch.empty {
+  background: var(--empty);
+}
+
+.verdict {
+  display: inline-block;
+  font-weight: 700;
+  padding: 2px 10px;
+}
+.verdict.go {
+  background: var(--go-soft);
+  color: var(--go);
+}
+.verdict.nogo {
+  background: var(--nogo-soft);
+  color: var(--nogo);
+}
+.detail dl,
+.conditions dl {
+  display: grid;
+  grid-template-columns: auto 1fr;
+  gap: 6px 16px;
+  margin: 16px 0 0;
+}
+dt {
+  color: var(--ink-soft);
+}
+dd {
+  margin: 0;
+  font-variant-numeric: tabular-nums;
+}
+.reason {
+  margin: 12px 0 0;
+}
+.big-number {
+  margin: 0;
+  font-size: 1.75rem;
+  font-weight: 700;
+  letter-spacing: -0.02em;
+}
+
+details {
+  margin-top: 32px;
+}
+summary {
+  cursor: pointer;
+  font-weight: 600;
+  min-height: 44px;
+  display: flex;
+  align-items: center;
+}
+
+@media (max-width: 600px) {
+  .day,
+  .hour-scale {
+    grid-template-columns: 56px minmax(0, 1fr);
+  }
+  .hour {
+    min-height: 28px;
+  }
+  .field-row {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * {
+    transition: none !important;
+  }
+  button:active {
+    transform: none;
+  }
+}
