diff -ruN 02-crud/services/forecast/app/models.py 03-forecast/services/forecast/app/models.py
--- 02-crud/services/forecast/app/models.py	1970-01-01 01:00:00
+++ 03-forecast/services/forecast/app/models.py	2026-11-22 20:15:19
@@ -0,0 +1,25 @@
+"""ORM models. The schema itself is owned by the migrations in migrations/versions."""
+
+from datetime import UTC, datetime
+
+from sqlalchemy import DateTime, Integer, String, UnicodeText
+from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column
+
+
+def utcnow() -> datetime:
+    return datetime.now(UTC).replace(tzinfo=None)
+
+
+class Base(DeclarativeBase):
+    pass
+
+
+class ForecastCacheEntry(Base):
+    """One cached upstream answer per (kind, rounded lat, rounded lon, days)."""
+
+    __tablename__ = "forecast_cache"
+
+    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
+    cache_key: Mapped[str] = mapped_column(String(100), unique=True)
+    payload: Mapped[str] = mapped_column(UnicodeText)
+    fetched_at: Mapped[datetime] = mapped_column(DateTime, default=utcnow)
diff -ruN 02-crud/services/forecast/app/openmeteo.py 03-forecast/services/forecast/app/openmeteo.py
--- 02-crud/services/forecast/app/openmeteo.py	1970-01-01 01:00:00
+++ 03-forecast/services/forecast/app/openmeteo.py	2026-11-22 20:15:19
@@ -0,0 +1,133 @@
+"""Open-Meteo client: wind from the weather API, waves from the Marine API (no key needed).
+
+Every call has a hard timeout. Any failure becomes UpstreamError with a short, clear reason.
+"""
+
+import logging
+import time
+
+import httpx
+
+from app.config import Settings
+
+log = logging.getLogger("upstream")
+
+WIND_VARS = "wind_speed_10m,wind_gusts_10m,wind_direction_10m"
+WAVE_VARS = "wave_height,wave_direction,wave_period"
+
+
+class UpstreamError(Exception):
+    """Open-Meteo is down, slow, or answered with an error."""
+
+
+def _utc(t: str) -> str:
+    """Open-Meteo returns '2026-11-22T13:00' in the requested timezone (UTC)."""
+    return t if t.endswith("Z") else f"{t}Z"
+
+
+class OpenMeteoClient:
+    def __init__(self, http: httpx.Client, settings: Settings) -> None:
+        self.http = http
+        self.settings = settings
+
+    def _get(self, name: str, url: str, params: dict) -> dict:
+        start = time.perf_counter()
+        status = None
+        try:
+            response = self.http.get(url, params=params, timeout=self.settings.upstream_timeout_s)
+            status = response.status_code
+            response.raise_for_status()
+            data = response.json()
+            if not isinstance(data, dict) or data.get("error"):
+                raise UpstreamError(f"{name} returned an error: {data.get('reason', 'unknown')}")
+            return data
+        except httpx.TimeoutException as exc:
+            raise UpstreamError(
+                f"{name} did not answer within {self.settings.upstream_timeout_s:g}s"
+            ) from exc
+        except httpx.HTTPStatusError as exc:
+            raise UpstreamError(f"{name} answered HTTP {status}") from exc
+        except (httpx.HTTPError, ValueError) as exc:
+            raise UpstreamError(f"{name} is unreachable ({type(exc).__name__})") from exc
+        finally:
+            log.info(
+                "upstream call",
+                extra={
+                    "fields": {
+                        "upstream": name,
+                        "status": status,
+                        "duration_ms": round((time.perf_counter() - start) * 1000, 1),
+                    }
+                },
+            )
+
+    def _params(self, lat: float, lon: float, **extra) -> dict:
+        return {"latitude": lat, "longitude": lon, "timezone": "UTC", **extra}
+
+    def hourly(self, lat: float, lon: float, days: int) -> list[dict]:
+        weather = self._get(
+            "open-meteo-weather",
+            self.settings.weather_url,
+            self._params(lat, lon, hourly=WIND_VARS, wind_speed_unit="kn", forecast_days=days),
+        )
+        marine = self._get(
+            "open-meteo-marine",
+            self.settings.marine_url,
+            self._params(lat, lon, hourly=WAVE_VARS, forecast_days=days),
+        )
+        return merge_hourly(weather.get("hourly", {}), marine.get("hourly", {}))
+
+    def current(self, lat: float, lon: float) -> dict:
+        weather = self._get(
+            "open-meteo-weather",
+            self.settings.weather_url,
+            self._params(lat, lon, current=WIND_VARS, wind_speed_unit="kn"),
+        )
+        marine = self._get(
+            "open-meteo-marine",
+            self.settings.marine_url,
+            self._params(lat, lon, current=WAVE_VARS),
+        )
+        w, m = weather.get("current", {}), marine.get("current", {})
+        return {
+            "time": _utc(w.get("time") or m.get("time", "")),
+            "wind_kn": w.get("wind_speed_10m"),
+            "gust_kn": w.get("wind_gusts_10m"),
+            "wind_dir_deg": w.get("wind_direction_10m"),
+            "wave_m": m.get("wave_height"),
+            "wave_dir_deg": m.get("wave_direction"),
+            "wave_period_s": m.get("wave_period"),
+        }
+
+
+def merge_hourly(weather: dict, marine: dict) -> list[dict]:
+    """Join the two hourly series on time. Missing values stay None (e.g. waves on land)."""
+    waves = {
+        t: (h, d, p)
+        for t, h, d, p in zip(
+            marine.get("time", []),
+            marine.get("wave_height", []),
+            marine.get("wave_direction", []),
+            marine.get("wave_period", []),
+            strict=False,
+        )
+    }
+    hours = []
+    for i, t in enumerate(weather.get("time", [])):
+        wave_h, wave_d, wave_p = waves.get(t, (None, None, None))
+        hours.append(
+            {
+                "time": _utc(t),
+                "wind_kn": _at(weather.get("wind_speed_10m"), i),
+                "gust_kn": _at(weather.get("wind_gusts_10m"), i),
+                "wind_dir_deg": _at(weather.get("wind_direction_10m"), i),
+                "wave_m": wave_h,
+                "wave_dir_deg": wave_d,
+                "wave_period_s": wave_p,
+            }
+        )
+    return hours
+
+
+def _at(values: list | None, i: int):
+    return values[i] if values and i < len(values) else None
diff -ruN 02-crud/services/forecast/app/routers/forecast.py 03-forecast/services/forecast/app/routers/forecast.py
--- 02-crud/services/forecast/app/routers/forecast.py	1970-01-01 01:00:00
+++ 03-forecast/services/forecast/app/routers/forecast.py	2026-11-22 20:15:19
@@ -0,0 +1,64 @@
+from typing import Annotated
+
+from fastapi import APIRouter, HTTPException, Query, Request
+
+from app import cache
+from app.db import SessionDep
+from app.openmeteo import OpenMeteoClient
+from app.service import ForecastUnavailable, cached_fetch
+
+router = APIRouter(tags=["forecast"])
+
+Lat = Annotated[float, Query(ge=-90, le=90, description="Latitude, decimal degrees")]
+Lon = Annotated[float, Query(ge=-180, le=180, description="Longitude, decimal degrees")]
+
+
+def _client(request: Request) -> OpenMeteoClient:
+    return OpenMeteoClient(request.app.state.http, request.app.state.settings)
+
+
+def _meta(lat: float, lon: float, status: str, age: float) -> dict:
+    return {
+        "latitude": round(lat, 2),
+        "longitude": round(lon, 2),
+        "source": "open-meteo",
+        "cache": status,
+        "age_s": round(age),
+        "stale": status == "stale",
+    }
+
+
+@router.get("/forecast")
+def forecast(
+    request: Request,
+    session: SessionDep,
+    lat: Lat,
+    lon: Lon,
+    days: Annotated[int, Query(ge=1, le=7)] = 3,
+):
+    """Hourly wind (kn), gusts (kn) and significant wave height (m), UTC."""
+    lat, lon = round(lat, 2), round(lon, 2)
+    settings = request.app.state.settings
+    key = cache.cache_key("forecast", lat, lon, days)
+    try:
+        hours, status, age = cached_fetch(
+            session, key, settings.forecast_ttl_s, lambda: _client(request).hourly(lat, lon, days)
+        )
+    except ForecastUnavailable as exc:
+        raise HTTPException(503, f"Forecast unavailable: {exc}") from exc
+    return {**_meta(lat, lon, status, age), "hours": hours}
+
+
+@router.get("/current")
+def current(request: Request, session: SessionDep, lat: Lat, lon: Lon):
+    """Current wind and sea state at a point."""
+    lat, lon = round(lat, 2), round(lon, 2)
+    settings = request.app.state.settings
+    key = cache.cache_key("current", lat, lon)
+    try:
+        now, status, age = cached_fetch(
+            session, key, settings.current_ttl_s, lambda: _client(request).current(lat, lon)
+        )
+    except ForecastUnavailable as exc:
+        raise HTTPException(503, f"Current conditions unavailable: {exc}") from exc
+    return {**_meta(lat, lon, status, age), "current": now}
diff -ruN 02-crud/services/forecast/app/service.py 03-forecast/services/forecast/app/service.py
--- 02-crud/services/forecast/app/service.py	1970-01-01 01:00:00
+++ 03-forecast/services/forecast/app/service.py	2026-11-22 20:15:19
@@ -0,0 +1,39 @@
+"""Cache-first forecast lookups with graceful degradation.
+
+fresh cache -> serve it ("hit")
+otherwise   -> call Open-Meteo and store it ("miss")
+upstream down -> serve the last cached copy, marked stale ("stale")
+upstream down and nothing cached -> ForecastUnavailable (HTTP 503 with a clear message)
+"""
+
+import logging
+from collections.abc import Callable
+
+from sqlalchemy.orm import Session
+
+from app import cache
+from app.openmeteo import UpstreamError
+
+log = logging.getLogger(__name__)
+
+
+class ForecastUnavailable(Exception):
+    pass
+
+
+def cached_fetch(
+    session: Session, key: str, ttl_s: int, fetch: Callable[[], dict | list]
+) -> tuple[dict | list, str, float]:
+    """Return (data, cache_status, age_seconds)."""
+    hit = cache.get(session, key)
+    if hit and hit[1] <= ttl_s:
+        return hit[0]["data"], "hit", hit[1]
+    try:
+        data = fetch()
+    except UpstreamError as exc:
+        if hit:
+            log.warning("serving stale forecast", extra={"fields": {"reason": str(exc)}})
+            return hit[0]["data"], "stale", hit[1]
+        raise ForecastUnavailable(f"{exc}; no cached data for this location") from exc
+    cache.put(session, key, {"data": data})
+    return data, "miss", 0.0
diff -ruN 02-crud/services/forecast/migrations/env.py 03-forecast/services/forecast/migrations/env.py
