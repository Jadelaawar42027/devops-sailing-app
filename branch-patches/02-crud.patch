diff -ruN 01-ci/services/api/tests/test_boats.py 02-crud/services/api/tests/test_boats.py
--- 01-ci/services/api/tests/test_boats.py	1970-01-01 01:00:00
+++ 02-crud/services/api/tests/test_boats.py	2026-11-22 20:11:48
@@ -0,0 +1,66 @@
+import pytest
+
+from tests.conftest import BOAT
+
+
+def test_create_and_get_boat(client, boat):
+    assert boat["id"] > 0
+    assert boat["name"] == "Aurora"
+    assert client.get(f"/boats/{boat['id']}").json()["max_wave_m"] == 2.0
+
+
+def test_list_boats(client, boat):
+    response = client.get("/boats")
+    assert response.status_code == 200
+    assert [b["id"] for b in response.json()] == [boat["id"]]
+
+
+def test_update_boat(client, boat):
+    body = {**BOAT, "name": "Aurora II", "max_wind_kn": 22}
+    response = client.put(f"/boats/{boat['id']}", json=body)
+    assert response.status_code == 200
+    assert response.json()["name"] == "Aurora II"
+    assert response.json()["max_wind_kn"] == 22
+
+
+def test_delete_boat(client, boat):
+    assert client.delete(f"/boats/{boat['id']}").status_code == 204
+    assert client.get(f"/boats/{boat['id']}").status_code == 404
+
+
+def test_missing_boat_returns_404(client):
+    assert client.get("/boats/999").status_code == 404
+    assert client.put("/boats/999", json=BOAT).status_code == 404
+    assert client.delete("/boats/999").status_code == 404
+
+
+def test_name_is_trimmed_and_gust_optional(client):
+    response = client.post("/boats", json={**BOAT, "name": "  Breeze  ", "max_gust_kn": None})
+    assert response.status_code == 201
+    assert response.json()["name"] == "Breeze"
+    assert response.json()["max_gust_kn"] is None
+
+
+@pytest.mark.parametrize(
+    "change",
+    [
+        {"name": ""},
+        {"name": "x" * 101},
+        {"max_wind_kn": 0},
+        {"max_wind_kn": -5},
+        {"max_wave_m": 0},
+        {"max_wave_m": 99},
+        {"max_gust_kn": 10},  # below max_wind_kn
+        {"unknown": 1},
+    ],
+)
+def test_invalid_boat_is_rejected(client, change):
+    response = client.post("/boats", json={**BOAT, **change})
+    assert response.status_code == 422
+
+
+def test_cannot_delete_boat_with_passages(client, boat, passage_body):
+    assert client.post("/passages", json=passage_body).status_code == 201
+    response = client.delete(f"/boats/{boat['id']}")
+    assert response.status_code == 409
+    assert "passages" in response.json()["detail"]
diff -ruN 01-ci/services/api/tests/test_db.py 02-crud/services/api/tests/test_db.py
--- 01-ci/services/api/tests/test_db.py	1970-01-01 01:00:00
+++ 02-crud/services/api/tests/test_db.py	2026-11-22 20:11:48
@@ -0,0 +1,62 @@
+import pytest
+from sqlalchemy import inspect
+from sqlalchemy.exc import OperationalError
+
+from app import db
+from app.config import Settings, database_url_from_env
+
+
+def test_migrations_create_tables(client):
+    tables = set(inspect(client.app.state.engine).get_table_names())
+    assert {"boats", "passages", "alembic_version"} <= tables
+
+
+def test_migrations_are_idempotent(client):
+    db.run_migrations(client.app.state.engine)  # second run is a no-op
+
+
+def test_prepare_database_retries_then_raises(monkeypatch):
+    calls = []
+
+    def boom(engine):
+        calls.append(1)
+        raise OperationalError("SELECT 1", {}, Exception("paused"))
+
+    monkeypatch.setattr(db, "run_migrations", boom)
+    settings = Settings(db_connect_retries=3, db_retry_delay_s=0)
+    with pytest.raises(OperationalError):
+        db.prepare_database(settings, engine=None)
+    assert len(calls) == 3
+
+
+def test_database_error_returns_503_not_500(client, monkeypatch):
+    def broken(*args, **kwargs):
+        raise OperationalError("SELECT 1", {}, Exception("database paused"))
+
+    monkeypatch.setattr("sqlalchemy.orm.Session.scalars", broken)
+    response = client.get("/boats")
+    assert response.status_code == 503
+    assert "Database unavailable" in response.json()["detail"]
+
+
+def test_database_url_from_env(monkeypatch):
+    monkeypatch.delenv("DATABASE_URL", raising=False)
+    monkeypatch.delenv("DB_HOST", raising=False)
+    assert str(database_url_from_env()).startswith("sqlite")
+
+    monkeypatch.setenv("DB_HOST", "sql.example.net")
+    monkeypatch.setenv("DB_NAME", "apidb")
+    monkeypatch.setenv("DB_USER", "u")
+    monkeypatch.setenv("DB_PASSWORD", "p@ss;word")
+    url = database_url_from_env()
+    assert url.drivername == "mssql+pyodbc"
+    assert url.database == "apidb"
+    assert url.password == "p@ss;word"
+    assert url.query["TrustServerCertificate"] == "no"
+
+    monkeypatch.setenv("DATABASE_URL", "sqlite:///x.db")
+    assert database_url_from_env() == "sqlite:///x.db"
+
+
+def test_create_database_if_missing_ignores_sqlite():
+    db.create_database_if_missing("sqlite:///:memory:")  # no-op, must not raise
diff -ruN 01-ci/services/api/tests/test_passages.py 02-crud/services/api/tests/test_passages.py
--- 01-ci/services/api/tests/test_passages.py	1970-01-01 01:00:00
+++ 02-crud/services/api/tests/test_passages.py	2026-11-22 20:11:48
@@ -0,0 +1,55 @@
+import pytest
+
+
+def test_passage_crud_roundtrip(client, passage_body):
+    created = client.post("/passages", json=passage_body)
+    assert created.status_code == 201
+    pid = created.json()["id"]
+
+    assert client.get(f"/passages/{pid}").json()["name"] == "Barcelona to Mallorca"
+
+    updated = client.put(f"/passages/{pid}", json={**passage_body, "speed_kn": 7.5})
+    assert updated.status_code == 200
+    assert updated.json()["speed_kn"] == 7.5
+
+    assert client.delete(f"/passages/{pid}").status_code == 204
+    assert client.get(f"/passages/{pid}").status_code == 404
+
+
+def test_list_passages_filters_by_boat(client, passage_body):
+    client.post("/passages", json=passage_body)
+    other = client.post("/boats", json={"name": "Other", "max_wind_kn": 15, "max_wave_m": 1}).json()
+    client.post("/passages", json={**passage_body, "boat_id": other["id"], "name": "Other trip"})
+
+    assert len(client.get("/passages").json()) == 2
+    only = client.get(f"/passages?boat_id={other['id']}").json()
+    assert [p["name"] for p in only] == ["Other trip"]
+
+
+def test_passage_for_unknown_boat_is_rejected(client, passage_body):
+    response = client.post("/passages", json={**passage_body, "boat_id": 999})
+    assert response.status_code == 422
+    assert response.json()["detail"] == "Boat 999 does not exist"
+
+
+def test_missing_passage_returns_404(client, passage_body):
+    assert client.get("/passages/999").status_code == 404
+    assert client.put("/passages/999", json=passage_body).status_code == 404
+    assert client.delete("/passages/999").status_code == 404
+
+
+@pytest.mark.parametrize(
+    "change",
+    [
+        {"start_lat": 91},
+        {"end_lat": -91},
+        {"start_lon": 181},
+        {"end_lon": -181},
+        {"speed_kn": 0},
+        {"speed_kn": 41},
+        {"name": ""},
+        {"boat_id": 0},
+    ],
+)
+def test_invalid_passage_is_rejected(client, passage_body, change):
+    assert client.post("/passages", json={**passage_body, **change}).status_code == 422
